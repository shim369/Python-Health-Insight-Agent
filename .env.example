# cp .env.example .env して値を設定。.env はコミットしない。

# 開発用DB(docker compose up -d で起動。ホスト側ポート5433)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/health_insight

# 既存アプリ(Neon等)を読むときだけ設定。書き込み権限の無い専用ユーザーのURLのみ使うこと。
READONLY_DATABASE_URL=

# 認証の代用(固定のデモユーザー)
DEMO_USER_ID=00000000-0000-4000-8000-000000000001

# ツールの呼び方: direct(関数を直接呼ぶ)または mcp(MCPサーバーを子プロセスで起動して経由)
TOOL_TRANSPORT=direct
# "gemini" または "fake"(fakeはAPIキー不要)
AI_PROVIDER=fake
# 未設定なら gemini-3.6-flash(安定版)。モデルは環境変数で切替可能
GEMINI_MODEL=
GEMINI_API_KEY=
LOG_LEVEL=INFO
