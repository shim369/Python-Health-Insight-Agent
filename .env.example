# cp .env.example .env して値を設定。.env はコミットしない。

# 開発用DB(docker compose up -d で起動。ホスト側ポート5433)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/health_insight

# 任意。空のままでOK(その場合は上のDATABASE_URLを、READ ONLYトランザクションで読む)。
# 既存アプリのDB(Neon等)を読むときや、DBロールによる防御をローカルでも有効にしたいときに、
# 「書き込み権限の無い専用ユーザー」のURLだけを入れる。作り方はREADMEの「設定」を参照。
READONLY_DATABASE_URL=

# 認証の代用(固定のデモユーザー)
DEMO_USER_ID=00000000-0000-4000-8000-000000000001

# ツールの呼び方: direct(関数を直接呼ぶ)または mcp(MCPサーバーを子プロセスで起動して経由)
TOOL_TRANSPORT=direct
# "gemini" または "fake"(fakeはAPIキー不要)
AI_PROVIDER=fake
# 未設定なら gemini-3.6-flash(安定版)。モデルは環境変数で切替可能
GEMINI_MODEL=
GEMINI_API_KEY=
# 埋め込み(メモのRAG)のモデル。未設定なら gemini-embedding-2
GEMINI_EMBEDDING_MODEL=
LOG_LEVEL=INFO

# --- 機能スイッチ(既定は全て on) ---
SQL_TOOL=on          # ガード付きSQLツール
ML_TOOL=on           # 睡眠予測モデルのツール
ML_TRACKING=on       # MLflow(ローカルSQLite: mlruns/)への記録
# ML_ARTIFACT_DIR=   # 採用判断JSONの保存先(既定 ml_artifacts/)
CHAT_RATE_LIMIT_PER_MIN=20
# フロントエンド開発サーバーのオリジン(カンマ区切り)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
